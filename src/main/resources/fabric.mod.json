{
  "schemaVersion": 1,
  "id": "communal-pets",
  "version": "${version}",
  "name": "Communal Pets",
  "description": "Share your tamed pets: extra caretakers, behavior modes (follow commander / nearest guardian / wander / sit), and owner-group glow feedback. Pure server-side - clients without this mod can join.",
  "authors": [
    "Lunaunde"
  ],
  "contact": {
    "homepage": "https://github.com/Lunaunde/communal-pets",
    "sources": "https://github.com/Lunaunde/communal-pets"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/communal-pets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.lunaunde.communalpets.CommunalPets"
    ]
  },
  "mixins": [
    "communal-pets.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
